TENSORIX_API_KEY=your_key_here
TENSORIX_BASE_URL=https://api.tensorix.ai/v1
TENSORIX_MODEL=deepseek/deepseek-r1-0528

# GitHub Portfolio Intelligence (optional — only needed for /api/sync-github
# and the `npm run ingest:github` CLI script).
# Create a classic PAT with "public_repo" read scope at:
#   https://github.com/settings/tokens
GITHUB_TOKEN=your_github_pat_here
GITHUB_USERNAME=your_github_username
